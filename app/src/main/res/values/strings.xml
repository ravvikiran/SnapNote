    <string name="onboarding_get_started">Get Started</string>
    <string name="onboarding_title_1">Capture Screenshots</string>
    <string name="onboarding_desc_1">SnapNote scans your device\'s screenshot folder and imports them automatically. Just tap \"Scan Existing Screenshots\" on the home screen to get started.</string>
    <string name="onboarding_title_2">Extract Text with OCR</string>
    <string name="onboarding_desc_2">Using Google\'s ML Kit, SnapNote reads the text inside your screenshots. Receipts, code snippets, messages — all searchable instantly.</string>
    <string name="onboarding_title_3">Auto-Tag and Categorize</string>
    <string name="onboarding_desc_3">SnapNote automatically suggests tags like #finance, #programming, or #food based on the extracted text. Notes are organized into categories for easy browsing.</string>
    <string name="onboarding_title_4">Search Everything</string>
    <string name="onboarding_desc_4">Use the search bar to find any screenshot by its text content, tags, or category. Filter by category chips for quick access to specific groups.</string>
    <string name="onboarding_title_5">Edit and Manage</string>
    <string name="onboarding_desc_5">Tap any screenshot to view details. Edit the extracted text, update tags, or change the category. Delete notes you no longer need with a confirmation prompt.</string>
